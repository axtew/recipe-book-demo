# Template for your own deployment. Copy it to `.env.production` (read by `pnpm build`)
# and replace the placeholders with your Supabase project's values:
# Project Settings -> API (URL) and API Keys (publishable key).
#
# Both values end up in the client bundle, so only the publishable key belongs here.
# Never put the secret key (`sb_secret_...`) or the database password into any
# `.env*` file or build variable: the secret key bypasses row level security.
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-publishable-key>

# Demo build only (`pnpm build:demo` reads `.env.demo`, not this file); leave unset for a
# regular deployment. See supabase/demo/DEPLOY.md.
# VITE_DEMO=true
# VITE_DEMO_EMAIL=demo@example.com
# VITE_DEMO_PASSWORD=<shared demo password>
