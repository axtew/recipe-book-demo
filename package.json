{
  "name": "recipe-book",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:prod": "vite --mode production",
    "dev:demo": "vite --mode demo-local",
    "build": "vite build && tsc -b",
    "build:demo": "vite build --mode demo",
    "deploy:demo": "pnpm build:demo && wrangler deploy -c wrangler.demo.jsonc",
    "preview": "vite preview",
    "lint": "eslint .",
    "prettier": "prettier --write .",
    "format": "prettier --write src",
    "test": "vitest",
    "db:reset": "npx supabase db reset",
    "db:types": "npx supabase gen types typescript --local > src/types/database.types.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mantine/core": "9.7.3",
    "@mantine/dates": "9.7.3",
    "@mantine/hooks": "9.7.3",
    "@mantine/notifications": "9.7.3",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/query-async-storage-persister": "^5.102.8",
    "@tanstack/query-persist-client-core": "^5.102.8",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-query-persist-client": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "browser-image-compression": "^2.0.2",
    "dayjs": "^1.11.23",
    "idb-keyval": "^6.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "styled-components": "^6.5.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "supabase": "^2.116.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  }
}
