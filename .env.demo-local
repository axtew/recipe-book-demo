# Демо-режим против ЛОКАЛЬНОГО стека Supabase — `pnpm dev:demo`. Нужен, чтобы
# проверять демо-интерфейс (плашка, готовый логин, закрытая загрузка фото) без
# облака. В облако эти значения не попадают: `build:demo` читает `.env.demo`.
# Здесь только значения локального стека и дев-пользователя — они одинаковы на
# любой машине и уже описаны в docs/agents/local-environment.md.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
VITE_DEMO=true
